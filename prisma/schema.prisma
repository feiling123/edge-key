generator client_cf {
  provider = "prisma-client"
  output   = "../generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

enum CategoryStatus {
  ACTIVE
  DISABLED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum ProductDeliveryType {
  CARD_AUTO
  MANUAL
}

enum ProductStockMode {
  FINITE
  UNLIMITED
}

enum CardStatus {
  UNUSED
  LOCKED
  SOLD
  DISABLED
}

enum ContactType {
  EMAIL
  QQ
  TELEGRAM
  OTHER
}



enum TelegramScene {
  TEST
  ORDER_PAID
  DELIVERY_SUCCESS
  DELIVERY_FAILED
}

enum TelegramSendStatus {
  SUCCESS
  FAILED
}

enum OrderStatus {
  PENDING
  PAID
  DELIVERED
  CLOSED
  FAILED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
}

enum DeliveryStatus {
  NOT_DELIVERED
  DELIVERED
  FAILED
}

enum DeliveryRecordType {
  CARD
  MANUAL
}

enum DeliveryRecordStatus {
  SUCCESS
  FAILED
}

enum PaymentVerifyStatus {
  PENDING
  VERIFIED
  FAILED
}

enum BlogPostStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

model Admin {
  id            Int                 @id @default(autoincrement())
  username      String              @unique
  passwordHash  String
  nickname      String?
  email         String?
  status        AdminStatus         @default(ACTIVE)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  operationLogs AdminOperationLog[]
}

model SiteSetting {
  id             Int      @id @default(1)
  siteName       String
  siteUrl        String?
  siteSubtitle   String?
  logoIcon       String?
  logo           String?
  notice         String?
  noticePageZh   String?
  noticePageEn   String?
  aboutPageZh    String?
  aboutPageEn    String?
  supportContact String?
  footerText     String?
  orderNotice    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model RuntimeSecret {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          Int            @id @default(autoincrement())
  name        String
  slug        String         @unique
  description String?
  sort        Int            @default(0)
  status      CategoryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  products    Product[]
}

model Product {
  id                Int                 @id @default(autoincrement())
  categoryId        Int?
  name              String
  slug              String              @unique
  subtitle          String?
  description       String?
  coverImage        String?
  price             Int
  status            ProductStatus       @default(DRAFT)
  deliveryType      ProductDeliveryType @default(CARD_AUTO)
  stockMode         ProductStockMode    @default(FINITE)
  minBuy            Int                 @default(1)
  maxBuy            Int                 @default(1)
  sort              Int                 @default(0)
  isVisibleStock    Boolean             @default(true)
  isContactRequired Boolean             @default(true)
  purchaseNote      String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  category          Category?           @relation(fields: [categoryId], references: [id])
  cards             Card[]
  orders            Order[]

  @@index([categoryId])
  @@index([status, sort])
}

model Card {
  id        Int        @id @default(autoincrement())
  productId Int
  content   String
  status    CardStatus @default(UNUSED)
  batchNo   String?
  orderId   Int?
  soldAt    DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  product   Product    @relation(fields: [productId], references: [id])
  order     Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@index([orderId])
}

model Order {
  id                  Int             @id @default(autoincrement())
  orderNo             String          @unique
  queryToken          String
  productId           Int
  productNameSnapshot String
  unitPrice           Int
  quantity            Int
  amount              Int
  contactType         ContactType     @default(EMAIL)
  contactValue        String?
  buyerNote           String?
  paymentProvider     String
  paymentChannel      String?
  paymentOrderNo      String?
  status              OrderStatus     @default(PENDING)
  paymentStatus       PaymentStatus   @default(UNPAID)
  deliveryStatus      DeliveryStatus  @default(NOT_DELIVERED)
  paidAt              DateTime?
  deliveredAt         DateTime?
  closedAt            DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  product             Product         @relation(fields: [productId], references: [id])
  cards               Card[]
  deliveries          OrderDelivery[]
  paymentLogs         PaymentLog[]
  telegramLogs        TelegramLog[]

  @@index([productId])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([deliveryStatus, createdAt])
}

model OrderDelivery {
  id              Int                  @id @default(autoincrement())
  orderId         Int
  deliveryType    DeliveryRecordType   @default(CARD)
  contentSnapshot String
  status          DeliveryRecordStatus @default(SUCCESS)
  createdAt       DateTime             @default(now())
  order           Order                @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
  @@unique([orderId, deliveryType, status])
}

model PaymentConfig {
  id         Int             @id @default(autoincrement())
  provider   String @unique
  name       String
  isEnabled  Boolean         @default(false)
  configJson String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model PaymentLog {
  id             Int                 @id @default(autoincrement())
  orderId        Int?
  provider       String
  orderNo        String?
  paymentOrderNo String?
  eventType      String
  rawPayload     String
  verifyStatus   PaymentVerifyStatus @default(PENDING)
  message        String?
  createdAt      DateTime            @default(now())
  order          Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([provider, createdAt])
  @@index([orderNo])
  @@index([orderId])
}

model TelegramConfig {
  id                    Int           @id @default(autoincrement())
  name                  String
  botToken              String
  chatId                String
  apiBaseUrl            String        @default("https://api.telegram.org")
  parseMode             String        @default("NONE")
  isEnabled             Boolean       @default(false)
  notifyOrderPaid       Boolean       @default(true)
  notifyDeliverySuccess Boolean       @default(true)
  notifyDeliveryFailed  Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  logs                  TelegramLog[]

  @@index([isEnabled])
}

model TelegramTemplate {
  id        Int           @id @default(autoincrement())
  scene     TelegramScene @unique
  name      String
  content   String
  isEnabled Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model TelegramLog {
  id                Int                @id @default(autoincrement())
  orderId           Int?
  configId          Int?
  scene             TelegramScene
  status            TelegramSendStatus @default(SUCCESS)
  chatId            String
  message           String
  telegramMessageId String?
  error             String?
  triggeredBy       String?
  createdAt         DateTime           @default(now())
  order             Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  config            TelegramConfig?    @relation(fields: [configId], references: [id], onDelete: SetNull)

  @@index([scene, createdAt])
  @@index([status, createdAt])
  @@index([orderId])
  @@index([configId, createdAt])
}

model BlogCategory {
  id            Int        @id @default(autoincrement())
  slug          String     @unique
  nameZh        String
  nameEn        String
  descriptionZh String?
  descriptionEn String?
  sort          Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  posts         BlogPost[]

  @@index([sort])
}

model BlogPost {
  id          Int            @id @default(autoincrement())
  categoryId  Int?
  slug        String         @unique
  titleZh     String
  titleEn     String
  excerptZh   String?
  excerptEn   String?
  contentZh   String
  contentEn   String
  status      BlogPostStatus @default(DRAFT)
  readMinutes Int            @default(3)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  category    BlogCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([status, publishedAt])
}

model AdminOperationLog {
  id         Int      @id @default(autoincrement())
  adminId    Int
  action     String
  targetType String
  targetId   String?
  detail     String?
  createdAt  DateTime @default(now())
  admin      Admin    @relation(fields: [adminId], references: [id])

  @@index([adminId, createdAt])
}
